# Copy this to .env.docker (gitignored) and fill in real values before running
# `docker compose up`. Mirrors backend/.env.example's own split between a committed template
# and a real, never-committed file.

# Self-hosted Postgres container's own credentials — these three ARE the DB that gets created
# inside the `db` service on first startup (Postgres's own image reads them directly), and
# docker-compose.yml assembles DATABASE_URL for the backend service from these same values, so
# there's only one place to change them.
POSTGRES_USER=sheetflow_app
POSTGRES_PASSWORD=change-this-to-a-real-password
POSTGRES_DB=sheetflow

# Same as backend/.env.example's own SECRET_KEY — generate a real random string, never reuse
# the dev one across environments.
SECRET_KEY=change-this-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Wherever the frontend actually ends up being served from on this VM (a domain, or the VM's
# own address+port) — same reasoning as render.yaml's own CORS_ORIGINS comment. Includes
# localhost:8080 by default since that's where docker-compose.yml's own `frontend` service
# publishes to — update this (and FRONTEND_API_BASE_URL below) together if you change that port.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# What the browser should call the backend at — baked into the frontend's JS at build time (see
# docker-compose.yml's own comment on the frontend service for why this can't be the internal
# Docker network address). Defaults to localhost:8000 if left unset, matching the backend
# service's own `ports:` mapping.
FRONTEND_API_BASE_URL=http://localhost:8000

# Same address as FRONTEND_API_BASE_URL is meant for the browser to reach, but this one is read
# by the backend itself to build the link inside a password-reset email — keep it in sync with
# wherever the frontend actually ends up (a real domain in a real deployment, not localhost:8080).
FRONTEND_BASE_URL=http://localhost:8080

# Leave the four below unset/blank to keep password-reset links logged to
# `docker compose logs backend` instead of actually emailed — the app works fine either way (see
# app/services/email_sender.py). Fill these in once you have a real SMTP provider (SendGrid, AWS
# SES, Mailgun, Gmail with an app password, ...) — any provider exposing standard SMTP works,
# since the backend just uses Python's stdlib smtplib, no provider-specific SDK.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
