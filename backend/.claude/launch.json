{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sheetflow-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload"],
      "port": 8000
    },
    {
      "name": "sheetflow-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "C:\\sheetflow_frontend",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "autoPort": false
    }
  ]
}
