DATABASE_URL=postgresql+psycopg2://sheetflow_app:sheetflow_dev_pw@localhost:5432/sheetflow_dev
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
STORAGE_ROOT=storage
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local dev needs none of the below — STORAGE_BACKEND defaults to "local", which stores files
# under STORAGE_ROOT only, same as always. Set STORAGE_BACKEND=s3 (and fill these in from your
# Supabase project's Storage > S3 Connection settings) to test against real Supabase Storage.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Where the frontend is served from — used to build the link inside a password-reset email.
FRONTEND_BASE_URL=http://localhost:5173

# Local dev needs none of the below — leaving SMTP_HOST unset means password-reset links are
# just logged to the backend console instead of emailed (see app/services/email_sender.py),
# so the flow is fully testable without a real mail account. Fill these in (any provider with
# a standard SMTP interface: Gmail with an app password, SendGrid, AWS SES, Mailgun, ...) to
# send real reset emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
